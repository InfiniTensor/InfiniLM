# Copy outside Git, use absolute host paths, and source before sbatch.
export HANDOFF_REPO=/path/to/InfiniLM
export TASK_ROOT=/path/to/current-runtime
export OLD_ROOT=/path/to/reference-assets
export MODEL_ROOT=/path/to/models
export CONTAINER_IMAGE=/path/to/dtk26-sandbox-or-image.sif
export BUILD_HOME=/path/to/container-build-home
export APPTAINER=apptainer
export HYHAL_ROOT=/opt/hyhal
export GRES=dcu:8
export GPU_ARCH=gfx936
export BUILD_JOBS=16
# Set only after discovering the new cluster. Do not copy old node names.
# export SLURM_ACCOUNT=...
# export SLURM_PARTITION=...
# export NCCL_SOCKET_IFNAME=...
# export NCCL_IB_HCA=...
# export NCCL_NET=Socket
# export NCCL_NET_PLUGIN=...

# Materialized profile: current or legacy. Use separate TASK_ROOT for each.
export HANDOFF_PROFILE=current
export HANDOFF_MODEL=GLM
